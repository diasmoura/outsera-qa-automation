
{
  "name": "outsera-qa-automation",
  "version": "1.0.0",
  "description": "Automação de testes Web, API e Performance com Cucumber, Playwright, BDD e K6",
  "main": "index.js",
  "scripts": {
    "test:bdd": "cucumber-js --format progress --format json:reports/bdd/cucumber-report.json features",
    "test:login": "cucumber-js --format progress features/WEB/login.feature",
    "test:checkout": "cucumber-js --format progress features/WEB/ecommerce-checkout.feature",
    "test:cart:add": "cucumber-js --name \"Adicionar produto ao carrinho\" features/WEB",
    "test:web": "cucumber-js --format progress --format json:reports/cucumber-web-report.json features/WEB",
    "test:api": "cucumber-js --format progress --format json:reports/cucumber-api-report.json features/API",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:k6:smoke": "k6 run performance/smoke-test.js",
    "test:k6:load": "k6 run performance/load-test.js",
    "report": "node cucumber-report.js",
    "dashboard": "node dashboard.js",
    "test:report": "npm run test:web && npm run test:api && npm run report",
    "test:all": "npm run test:web && npm run test:api && npm run test:playwright",
    "test:all:report": "npm run test:all && npm run report && npm run dashboard",
    "test:dashboard": "npm run dashboard"
  },
  "keywords": [
    "qa",
    "automacao",
    "testes",
    "api",
    "web",
    "playwright",
    "cucumber",
    "bdd",
    "performance",
    "k6"
  ],
  "author": "Lucas Dias",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "multiple-cucumber-html-reporter": "^4.5.0",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  }
}
