
{
  "name": "outsera-qa-automation",
  "version": "1.0.0",
  "description": "Automacao de testes de API e Web com Cucumber e Playwright",
  "main": "index.js",
  "scripts": {
    "test:bdd": "cucumber-js features --require \"./step-definitions/**/*.js\" --format json:reports/cucumber-report.json",
    "report": "node cucumber-report.js",
    "test:report": "npm run test:bdd && npm run report",
    "test:web": "playwright test",
    "test:web:report": "playwright test --reporter=html",
    "test:all": "npm run test:bdd && npm run test:web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "multiple-cucumber-html-reporter": "^4.5.0"
  }
}
